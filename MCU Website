    <!-- JavaScript Navigation & Interactive Functions -->
    <script>
        // Page switching logic
        function switchPage(pageId) {
            const homePage = document.getElementById('page-home');
            const techPage = document.getElementById('page-tech');
            const navHome = document.getElementById('nav-home');
            const navTech = document.getElementById('nav-tech');

            if (pageId === 'home') {
                homePage.classList.remove('hidden');
                techPage.classList.add('hidden');
                
                // Update navigation styling
                navHome.className = "px-4 py-2 rounded-md font-orbitron text-sm sm:text-base font-semibold transition-all duration-300 border border-stark-cyan/50 text-stark-cyan bg-stark-cyan/10 glow-cyan";
                navTech.className = "px-4 py-2 rounded-md font-orbitron text-sm sm:text-base font-semibold transition-all duration-300 border border-transparent text-gray-400 hover:text-stark-gold hover:border-stark-gold/40";
            } else if (pageId === 'tech') {
                techPage.classList.remove('hidden');
                homePage.classList.add('hidden');

                // Update navigation styling
                navTech.className = "px-4 py-2 rounded-md font-orbitron text-sm sm:text-base font-semibold transition-all duration-300 border border-stark-gold/50 text-stark-gold bg-stark-gold/10 glow-cyan";
                navHome.className = "px-4 py-2 rounded-md font-orbitron text-sm sm:text-base font-semibold transition-all duration-300 border border-transparent text-gray-400 hover:text-stark-cyan hover:border-stark-cyan/40";
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Arc Reactor overcharge click event
        let reactorOvercharge = false;
        function pulseArcReactor() {
            const reactor = document.getElementById('main-arc-reactor');
            const outputText = document.getElementById('reactor-output');
            
            if (!reactorOvercharge) {
                reactorOvercharge = true;
                outputText.innerText = '300% (OVERPOWER)';
                outputText.className = 'text-stark-gold font-bold animate-pulse';
                reactor.classList.add('glow-cyan-lg');
                
                setTimeout(() => {
                    outputText.innerText = '100%';
                    outputText.className = 'text-white font-bold';
                    reactor.classList.remove('glow-cyan-lg');
                    reactorOvercharge = false;
                }, 2500);
            }
        }

        // Suit Inspection Card System Data
        const suitData = {
            mk1: {
                tag: 'MK1',
                name: 'Mark I Prototype',
                role: 'Improvised Escape Armor',
                desc: 'Hand-crafted in a cave from crude materials. Includes dual arm-mounted flamethrowers and rocket launcher. Heavy and unrefined.',
                material: 'Cast Iron Scrap',
                weapons: 'Flamethrower / Rockets',
                power: 'Arc Reactor Mk I',
                durability: 65,
                speed: 20,
                energy: 40,
                fileID: 'STK-001-A'
            },
            mk7: {
                tag: 'MK7',
                name: 'Mark VII Deployable',
                role: 'Rapid Response Combat Unit',
                desc: 'Features pod-deployment with automatic assembly onto Tony Stark via tracking wristbands. Heavy laser pods and shoulder missile banks.',
                material: 'Gold-Titanium Alloy',
                weapons: 'Lasers / Missiles',
                power: 'Arc Reactor Mk III',
                durability: 82,
                speed: 85,
                energy: 80,
                fileID: 'STK-007-B'
            },
            mk44: {
                tag: 'MK44',
                name: 'Mark XLIV (Hulkbuster)',
                role: 'Heavy Suppression Armor System',
                desc: 'Deploys from orbit via the Veronica satellite module. Designed to encapsulate existing armor and neutralize code-red threats like the Hulk.',
                material: 'Impact-Resistant Plate',
                weapons: 'Pneumatic Jackhammers',
                power: 'Multi Arc Reactors',
                durability: 98,
                speed: 45,
                energy: 90,
                fileID: 'STK-044-H'
            },
            mk50: {
                tag: 'MK50',
                name: 'Mark L (Nanotech)',
                role: 'Nanotechnology Vanguard Armor',
                desc: 'Uses flexible nanites stored in the chest reactor to form weapons, wings, thrusters, shields, and repair structural integrity on command.',
                material: 'Nanite Fluid Matrix',
                weapons: 'Morphing Repulsors/Blade',
                power: 'Nanite Arc Reactor',
                durability: 95,
                speed: 98,
                energy: 99,
                fileID: 'STK-050-N'
            }
        };

        function inspectSuit(suitKey) {
            const data = suitData[suitKey];
            if (!data) return;

            // Highlight button
            document.querySelectorAll('.suit-btn').forEach(btn => {
                btn.classList.remove('border-stark-cyan', 'bg-stark-cyan/10');
                btn.classList.add('border-stark-cyan/20');
            });
            const activeBtn = document.getElementById(`btn-${suitKey}`);
            if(activeBtn) {
                activeBtn.classList.add('border-stark-cyan', 'bg-stark-cyan/10');
            }

            // Update content
            document.getElementById('suit-display-tag').innerText = data.tag;
            document.getElementById('suit-display-name').innerText = data.name;
            document.getElementById('suit-display-role').innerText = data.role;
            document.getElementById('suit-display-desc').innerText = data.desc;

            document.getElementById('spec-material').innerText = data.material;
            document.getElementById('spec-weapons').innerText = data.weapons;
            document.getElementById('spec-power').innerText = data.power;

            document.getElementById('stat-durability-val').innerText = `${data.durability}%`;
            document.getElementById('stat-durability-bar').style.width = `${data.durability}%`;

            document.getElementById('stat-speed-val').innerText = `${data.speed}%`;
            document.getElementById('stat-speed-bar').style.width = `${data.speed}%`;

            document.getElementById('stat-energy-val').innerText = `${data.energy}%`;
            document.getElementById('stat-energy-bar').style.width = `${data.energy}%`;

            document.getElementById('suit-file-id').innerText = data.fileID;
        }

        // Modal Helpers
        function showSuitPreview(name, detail, year) {
            const modalContent = document.getElementById('modal-content');
            modalContent.innerHTML = `
                <div class="space-y-3">
                    <span class="text-xs font-orbitron text-stark-gold border border-stark-gold/40 px-2 py-0.5 rounded">${year}</span>
                    <h3 class="font-orbitron text-2xl font-bold text-white">${name}</h3>
                    <p class="text-gray-300 text-sm leading-relaxed">${detail}</p>
                </div>
            `;
            document.getElementById('modal-backdrop').classList.remove('hidden');
        }

        function openGalleryModal(title, desc) {
            const modalContent = document.getElementById('modal-content');
            modalContent.innerHTML = `
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-full bg-stark-cyan/20 text-stark-cyan flex items-center justify-center text-xl">
